{
  "name": "moelog-monorepo",
  "version": "0.0.2-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "daemon": "node packages/node/dist/daemon.js",
    "clean": "rm -rf packages/*/dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "size": "size-limit",
    "publicar": "bun run scripts/publicar.ts",
    "publicar:ensayo": "bun run scripts/publicar.ts --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "size-limit": "14.2.0",
    "typescript": "^5.6.0"
  }
}
